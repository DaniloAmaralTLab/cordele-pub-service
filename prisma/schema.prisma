// Prisma schema for pub-service (cordele).
// Prisma + PostgreSQL is the Node persistence stack.
// Multi-tenancy (schema-per-tenant): all PUB
// tables live in the tenant schema (emp_<slug>), never in cordele_global.
// The DATABASE_URL is resolved per-request from EmpresaContext — the
// PrismaService receives a URL already pointing to the correct schema.
// The application layer must set the empresa context before touching
// any repository — a missing context is a data-integrity error, not just a
// slow query.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  output          = "../src/infrastructure/prisma-client"
}

/// ePub export attempt (aggregate root, PUB context).
/// Append-only history: a terminal row (publicado|com_erros) is never mutated.
/// Two status fields:
///   `status`          — async build-machine state
///   `epubcheckStatus` — epubcheck verdict
///
/// The partial unique index `uq_publicacao_projeto_inflight` (created in the
/// migration, not expressible in Prisma schema) enforces at most one non-terminal
/// build per project. Prisma @@unique only covers the per-project sequence
/// uniqueness (uq_publicacao_projeto_seq).
model Publicacao {
  id               String              @id @default(uuid()) @db.Uuid
  projetoId        String              @map("projeto_id") @db.Uuid
  status           String              @default("gerando")
  epubcheckStatus  String              @default("pendente") @map("epubcheck_status")
  sequencia        Int
  artefatoRef      String?             @map("artefato_ref")
  resumoErro       String?             @map("resumo_erro")
  totalErros       Int                 @default(0) @map("total_erros")
  totalAvisos      Int                 @default(0) @map("total_avisos")
  iniciadaEm       DateTime            @default(now()) @map("iniciada_em") @db.Timestamptz(6)
  concluidaEm      DateTime?           @map("concluida_em") @db.Timestamptz(6)
  tamanhoBytes     Int?                @map("tamanho_bytes")
  totalCapitulos   Int?                @map("total_capitulos")
  totalImagens     Int?                @map("total_imagens")

  validationMessages ValidationMessage[]

  @@unique([projetoId, sequencia], name: "uq_publicacao_projeto_seq")
  @@index([projetoId, status], name: "idx_publicacao_projeto_status")
  @@index([projetoId, iniciadaEm(sort: Desc)], name: "idx_publicacao_projeto_iniciada")
  @@map("publicacao")
}

/// One epubcheck report line — persisted for auditability.
/// Severity: error | warning | info (chk_validation_message_severity).
/// Cascade-deleted when the owning publicacao is deleted (FK ON DELETE CASCADE).
model ValidationMessage {
  id            String     @id @default(uuid()) @db.Uuid
  publicacaoId  String     @map("publicacao_id") @db.Uuid
  severity      String
  code          String
  message       String
  location      String?
  ordem         Int        @default(0)
  criadoEm      DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)

  publicacao    Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@index([publicacaoId, severity], name: "idx_validation_message_pub_sev")
  @@map("validation_message")
}
